# name: test/sql/secrets.test
# description: app tokens from socrata secrets, scoped per portal; hand-made private.example.org fixtures
# group: [socrata]
#
# private.example.org answers only requests carrying X-App-Token: test-token
# (test/mock_api/make_private.py writes its fixtures).

require vgi

require-env SOCRATA_WORKER

require-env SOCRATA_MOCK_API

statement ok
LOAD json;

statement ok
ATTACH 'socrata' (TYPE vgi, LOCATION '{SOCRATA_WORKER}');

# A token scoped to another portal is never sent here; the portal refuses (403).
statement ok
CREATE SECRET priv_url (TYPE socrata, SCOPE 'https://private.example.org', BASE_URL '{SOCRATA_MOCK_API}/private.example.org');

statement ok
CREATE SECRET other (TYPE socrata, SCOPE 'https://data.cityofnewyork.us', APP_TOKEN 'test-token');

statement error
SELECT * FROM socrata.main.dataset('private.example.org', 'abcd-1234');
----
<REGEX>:.*HTTP 403.*

# An unscoped secret is ignored too.
statement ok
CREATE SECRET unscoped (TYPE socrata, APP_TOKEN 'test-token');

statement error
SELECT * FROM socrata.main.dataset('private.example.org', 'abcd-1234');
----
<REGEX>:.*HTTP 403.*

statement ok
DROP SECRET priv_url;

statement ok
CREATE SECRET priv (TYPE socrata, SCOPE 'https://private.example.org', BASE_URL '{SOCRATA_MOCK_API}/private.example.org', APP_TOKEN 'test-token');

# The token is redacted when secrets are listed.
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'priv' AND secret_string LIKE '%test-token%';
----
0

# fixed_timestamp -> TIMESTAMPTZ, money/percent -> DECIMAL(28,10) (NULL past 18 integer digits),
# double -> DOUBLE, checkbox -> BOOLEAN, phone -> STRUCT, polygon -> GeoJSON JSON;
# :@computed_region columns are dropped.
query TTTTTTTTT
SELECT permit, issued_at, fee, share, score, paid, contact.phone_number, area->>'$.type', soda_row_id
FROM socrata.main.dataset('private.example.org', 'abcd-1234') ORDER BY permit;
----
P-1	2024-01-01 10:30:00+00	125.5000000000	12.5000000000	0.25	true	555-0100	Polygon	row-aaaa-0001
P-2	2024-02-01 00:00:00+00	NULL	NULL	NULL	false	NULL	NULL	row-aaaa-0002

query T
SELECT string_agg(column_name || ' ' || column_type, ', ' ORDER BY column_name) FROM (DESCRIBE SELECT * FROM socrata.main.dataset('private.example.org', 'abcd-1234'));
----
area JSON, contact STRUCT(phone_number VARCHAR, phone_type VARCHAR), fee DECIMAL(28,10), issued_at TIMESTAMP WITH TIME ZONE, paid BOOLEAN, permit VARCHAR, score DOUBLE, share DECIMAL(28,10), soda_row_id VARCHAR

# A fixed_timestamp filter is pushed as a UTC literal: `issued_at` >= '2024-01-15T00:00:00.000Z'
query T
SELECT permit FROM socrata.main.dataset('private.example.org', 'abcd-1234') WHERE issued_at >= TIMESTAMPTZ '2024-01-15 00:00:00+00';
----
P-2
