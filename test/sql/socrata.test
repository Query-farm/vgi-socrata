ygpa-z7cr	Housing Maintenance Code Complaints and Problems	Housing & Development	Department of Housing Preservation & Development (HPD)
76ig-c548	311 Service Requests from 2010 to 2019	Social Services	NULL
cs9t-e3x8	311 Service Level Agreements	City Government	311
5ijn-vbdv	311 Resolution Satisfaction Survey	City Government	Office of Technology and Innovation (OTI)

query TTTTT
SELECT portal, url, api_url, typeof(modified), typeof(tags) FROM socrata.main.datasets('data.cityofnewyork.us', q := '311 service requests')
WHERE dataset_id = 'erm2-nwe9';
----
https://data.cityofnewyork.us	https://data.cityofnewyork.us/d/erm2-nwe9	https://data.cityofnewyork.us/resource/erm2-nwe9.json	TIMESTAMP WITH TIME ZONE	VARCHAR[]

# dataset_id IN (...) -> ids=erm2-nwe9&ids=ygpa-z7cr
query TT
SELECT dataset_id, asset_type FROM socrata.main.datasets('data.cityofnewyork.us') WHERE dataset_id IN ('erm2-nwe9', 'ygpa-z7cr') ORDER BY 1;
----
erm2-nwe9	dataset
ygpa-z7cr	dataset

