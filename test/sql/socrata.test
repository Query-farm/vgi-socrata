calendar_date	2
checkbox	2
location	1

# ---------------------------------------------------------------- errors

statement error
SELECT * FROM socrata.main.dataset('data.cityofnewyork.us', 'erm2_nwe9');
----
<REGEX>:.*

statement error
SELECT * FROM socrata.main.dataset('data.cityofnewyork.us', 'zzzz-zzzz');
----
<REGEX>:.*HTTP 404.*

statement error
SELECT * FROM socrata.main.soql('data.cityofnewyork.us', 'erm2-nwe9', 'SELECT nonexistent_column');
----
<REGEX>:.*HTTP 400.*

statement error
SELECT * FROM socrata.main.datasets('example.com');
----
<REGEX>:.*does not know the domain.*

# ---------------------------------------------------------------- SoQL helpers

query T
SELECT socrata.main.soql_quote('O''Brien');
----
'O''Brien'

query T
SELECT socrata.main.soql_quote(NULL);
----
NULL

query T
SELECT socrata.main.soql_quote('%' || socrata.main.soql_like_escape('50%_x') || '%');
----
'%50\\%\\_x%'
