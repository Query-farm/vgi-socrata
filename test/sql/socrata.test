query TTT
SELECT field_name, data_type, duckdb_type FROM socrata.main.dataset_columns('data.cityofnewyork.us', 'erm2-nwe9')
WHERE NOT is_system ORDER BY position LIMIT 3;
----
unique_key	text	VARCHAR
created_date	calendar_date	TIMESTAMP
closed_date	calendar_date	TIMESTAMP

query TI
SELECT data_type, count(*) AS columns FROM socrata.main.dataset_columns('data.cityofchicago.org', 'ijzp-q8t2')
GROUP BY data_type ORDER BY columns DESC, data_type;
